// Custom/UI/Vault.rc
// 独立资源文件：完全不碰 7-Zip 自己的 .rc，
// 上游更新时不会出现资源 ID 冲突 / 行号漂移导致的合并冲突。

#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// 主窗口

IDD_VAULT DIALOGEX 0, 0, 300, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "密码库 - 7-Zip Custom"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
                    7, 7, 286, 140
    PUSHBUTTON      "新增(&A)", IDC_ADD,    7, 152, 50, 14
    PUSHBUTTON      "编辑(&E)", IDC_EDIT,  61, 152, 50, 14
    PUSHBUTTON      "删除(&D)", IDC_DEL,  115, 152, 50, 14
    CONTROL         "显示明文", IDC_REVEAL, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 172, 154, 60, 10
    PUSHBUTTON      "关闭",     IDC_CLOSE, 243, 152, 50, 14
    LTEXT           "", IDC_HINT, 7, 172, 286, 12
END

/////////////////////////////////////////////////////////////////////////////
// 新增 / 编辑条目

IDD_ENTRY DIALOGEX 0, 0, 224, 116
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "密码条目"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "归档名称（可用 * 和 ? 通配，例如 *.7z）", -1, 7, 7, 210, 8
    EDITTEXT        IDC_E_NAME, 7, 18, 176, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_E_BROWSE, 187, 18, 30, 12
    LTEXT           "密码", -1, 7, 36, 210, 8
    EDITTEXT        IDC_E_PASS, 7, 47, 176, 12, ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "", IDC_E_EYE, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP,
                    187, 47, 30, 12
    LTEXT           "备注", -1, 7, 65, 210, 8
    EDITTEXT        IDC_E_NOTE, 7, 76, 210, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "确定", IDOK,     112, 95, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 167, 95, 50, 14
END

/////////////////////////////////////////////////////////////////////////////
// 输入密码（替代 7-Zip 自带对话框，多了"从密码库选择"）

IDD_ASKPWD DIALOGEX 0, 0, 264, 128
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "输入密码"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "压缩包：", -1, 7, 8, 34, 8
    LTEXT           "", IDC_ASK_ARC, 42, 8, 215, 8
    LTEXT           "从密码库选择（可选）：", -1, 7, 24, 160, 8
    COMBOBOX        IDC_ASK_LIST, 7, 34, 250, 90,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "密码：", -1, 7, 56, 40, 8
    EDITTEXT        IDC_ASK_PASS, 7, 66, 210, 12, ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "", IDC_ASK_EYE, "Button",
                    BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 221, 66, 36, 12
    CONTROL         "把这个压缩包的密码存进密码库", IDC_ASK_SAVE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 7, 84, 200, 10
    PUSHBUTTON      "管理密码库...", IDC_ASK_MANAGE, 7, 104, 72, 14
    DEFPUSHBUTTON   "确定", IDOK,     152, 104, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 207, 104, 50, 14
END
